generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  login     String   @unique
  password  String
  name      String
  role      String   @default("partner")
  createdAt DateTime @default(now())
  sales     Sale[]
  receipts  StockReceipt[]
}

model Product {
  id               String            @id @default(cuid())
  name             String
  description      String?
  imageUrl         String?
  costPrice        Float
  listPrice        Float?
  stock            Int               @default(0)
  active           Boolean           @default(true)
  /// Витрина: souvenir | home
  catalogLine      String            @default("souvenir")
  weightGrams      Float?
  widthMm          Float?
  heightMm         Float?
  depthMm          Float?
  viewCount        Int               @default(0)
  buyClickCount    Int               @default(0)
  /// При нуле: show | soon | hide
  zeroStockMode    String            @default("soon")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sales            Sale[]
  receipts         StockReceipt[]
  priceHistory     PriceHistory[]
  feedbackMessages FeedbackMessage[]
  categories       ProductCategory[]
  buyClicks        ProductBuyClick[]
  holds            ProductHold[]
  images           ProductImage[]
  printRequests    PrintRequest[]
  deliveryLines    DeliveryOrderLine[]
  packagingId      String?
  packaging        Packaging?        @relation(fields: [packagingId], references: [id], onDelete: SetNull)

  @@index([catalogLine, active])
  @@index([packagingId])
}

model Packaging {
  id          String    @id @default(cuid())
  /// Код для автоподбора: mini | standard | fragile | long
  code        String    @unique
  name        String
  description String?
  boxWidthMm  Float?
  boxHeightMm Float?
  boxDepthMm  Float?
  stock       Int       @default(0)
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([active, sortOrder])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model Category {
  id        String            @id @default(cuid())
  name      String            @unique
  slug      String            @unique
  sortOrder Int               @default(0)
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  products  ProductCategory[]

  @@index([active, sortOrder])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model PriceHistory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPrice    Float?
  newPrice    Float?
  changedAt   DateTime @default(now())
  changedById String?
}

model Sale {
  id           String      @id @default(cuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id])
  quantity     Int         @default(1)
  amount       Float
  costTotal    Float
  profit       Float
  ownerShare   Float
  partnerShare Float
  note         String?
  soldAt       DateTime    @default(now())
  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id])
  createdById  String?
  createdBy    User?       @relation(fields: [createdById], references: [id])
}

model Settlement {
  id           String   @id @default(cuid())
  periodFrom   DateTime
  periodTo     DateTime @default(now())
  totalRevenue Float
  totalCost    Float
  totalProfit  Float
  ownerShare   Float
  partnerShare Float
  note         String?
  createdAt    DateTime @default(now())
  sales        Sale[]
}

model AppSetting {
  id                  String    @id @default("default")
  ownerSplitPercent   Float     @default(50)
  sessionEpoch        Int       @default(0)
  /// Последняя публикация объявления маркет-ботом (лимит 1/час)
  lastMarketPublishAt DateTime?
}

model StoreBanner {
  id        String   @id @default("default")
  title     String   @default("")
  text      String   @default("")
  imageUrl  String?
  active    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

/// Настройки витрины: график лета/зимы и период зимы.
model StoreSettings {
  id                String   @id @default("default")
  /// auto | summer | winter
  hoursMode         String   @default("auto")
  winterStartMonth  Int      @default(11)
  winterStartDay    Int      @default(1)
  winterEndMonth    Int      @default(3)
  winterEndDay      Int      @default(31)
  /// JSON: Record<weekday, {closed}|{openMinute,closeMinute}>
  summerHoursJson   String
  winterHoursJson   String
  /// Регистрация покупателя и заказ с доставкой. Пока false — на витрине этого нет.
  ordersEnabled     Boolean  @default(false)
  /// Строка «Продавец» на адресном ярлыке 100×150.
  sellerName        String   @default("")
  updatedAt         DateTime @updatedAt
}

model StockReceipt {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  note        String?
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
}

model SiteVisit {
  id          String   @id @default(cuid())
  ipAddress   String
  path        String
  userAgent   String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  visitorId   String?
  isReturning Boolean  @default(false)
  visitedAt   DateTime @default(now())

  @@index([ipAddress])
  @@index([visitedAt])
  @@index([visitorId])
}

/// Бронь на витрине: 1 шт на 2 часа, остаток на складе не списывается.
model ProductHold {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  phone       String
  quantity    Int       @default(1)
  visitorId   String?
  ipAddress   String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  releasedAt  DateTime?
  /// sold | cancelled
  releaseReason String?

  @@index([productId, expiresAt])
  @@index([phone, productId])
  @@index([expiresAt])
}

model ProductBuyClick {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  ipAddress   String
  userAgent   String?
  visitorId   String?
  clickedAt   DateTime  @default(now())
  /// null | called | agreed | bought | refused | no_answer
  outcome     String?
  outcomeNote String?
  outcomeAt   DateTime?

  @@index([productId, clickedAt])
  @@index([clickedAt])
  @@index([ipAddress])
  @@index([visitorId])
  @@index([outcome])
}

/// Покупатель витрины. Вход по телефону, без отдельного пароля.
model ShopCustomer {
  id        String          @id @default(cuid())
  phone     String          @unique
  name      String?
  email     String?
  createdAt DateTime        @default(now())
  orders    DeliveryOrder[]
}

/// Заказ с доставкой СДЭК. Пока заказы выключены, с витрины не создаётся.
/// Свободный остаток занимает только статус paid.
/// Отмена возвращает резерв. Передача в СДЭК списывает Product.stock.
model DeliveryOrder {
  id              String               @id @default(cuid())
  /// Номер в нашей системе. В СДЭК уходит как number.
  number          String               @unique
  customerId      String
  customer        ShopCustomer         @relation(fields: [customerId], references: [id])
  /// pvz — до пункта выдачи; door — курьер до двери
  deliveryMode    String
  recipientName   String
  recipientPhone  String
  recipientEmail  String?
  city            String
  /// Курьер: улица, дом, квартира
  address         String?
  /// ПВЗ: код точки СДЭК (delivery_point)
  pvzCode         String?
  pvzAddress      String?
  comment         String?
  goodsAmount     Float
  deliveryAmount  Float                @default(0)
  /// Наложенный платёж. При оплате сразу всегда 0.
  codAmount       Float                @default(0)
  /// awaiting_payment | paid | handed_to_cdek | cancelled
  status          String               @default("awaiting_payment")
  /// unpaid | paid
  paymentStatus   String               @default("unpaid")
  paidAt          DateTime?
  tariffCode      Int?
  cdekUuid        String?
  /// Трек СДЭК
  cdekNumber      String?
  cdekStatus      String?
  handedToCdekAt  DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  lines           DeliveryOrderLine[]
  events          DeliveryOrderEvent[]

  @@index([status, createdAt])
  @@index([customerId])
  @@index([cdekNumber])
}

model DeliveryOrderLine {
  id          String        @id @default(cuid())
  orderId     String
  order       DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  name        String
  quantity    Int
  price       Float
  weightGrams Float?

  @@index([orderId])
  @@index([productId])
}

/// История заказа: оплата, отмена, передача в СДЭК.
model DeliveryOrderEvent {
  id        String        @id @default(cuid())
  orderId   String
  order     DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime      @default(now())

  @@index([orderId, createdAt])
}

model PrintRequest {
  id           String   @id @default(cuid())
  /// catalog — свой товар без свободного остатка; world — модель из «В мире»
  source       String
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title        String
  priceLabel   String?
  sourceUrl    String?
  customerName String
  phone        String
  quantity     Int
  /// new | printing | ready | cancelled
  status       String   @default("new")
  ipAddress    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@index([productId])
}

model FeedbackMessage {
  id        String   @id @default(cuid())
  name      String?
  contact   String?
  message   String
  ipAddress String?
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([read])
  @@index([productId])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  type      String
  ipAddress String
  path      String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type])
  @@index([ipAddress])
}

model BlockedIp {
  id        String   @id @default(cuid())
  ipAddress String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@index([ipAddress])
}

model WorldTrendBatch {
  id          String              @id @default(cuid())
  weekLabel   String              @unique
  generatedAt DateTime            @default(now())
  source      String              @default("bot")
  articles    WorldTrendArticle[]

  @@index([generatedAt])
}

model WorldTrendArticle {
  id          String          @id @default(cuid())
  batchId     String
  batch       WorldTrendBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  name        String
  description String
  imageUrl    String?
  sourceUrl   String?
  priceTier   String
  priceLabel  String?
  /// popular — уже были в подборке; new — новинки этого завоза
  collection  String          @default("popular")
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())

  @@index([batchId])
  @@index([priceTier])
}

/// Цены на филамент с маркетплейсов: Маркет — автоматически, WB и Ozon — вручную.
model FilamentPrice {
  id          String   @id @default(cuid())
  /// Нормализованный запрос, по нему группируется история.
  query       String
  /// ym | wb | ozon
  marketplace String
  price       Int
  title       String   @default("")
  url         String   @default("")
  imageUrl    String   @default("")
  /// auto | manual
  source      String   @default("auto")
  createdAt   DateTime @default(now())

  @@index([query, createdAt])
}

/// Документы МООиР для раздела «Иное → Охота»: распоряжения, прейскурант, контакты Шатурского ОРХ.
/// Хранится текст как есть; сроки и цены разбираются при показе.
model HuntingSource {
  id          String    @id @default(cuid())
  url         String    @unique
  /// order | price | contacts
  kind        String
  title       String    @default("")
  docDate     DateTime?
  text        String    @default("")
  /// price: строки таблицы; contacts: ссылки
  dataJson    String    @default("")
  hash        String    @default("")
  firstSeenAt DateTime  @default(now())
  changedAt   DateTime  @default(now())
  fetchedAt   DateTime  @default(now())

  @@index([kind, docDate])
}

/// Что охотничий бот уже отправил в группу (напоминания, недельные сводки) — чтобы не дублировать.
/// Отслеживаемые законы об охоте и оружии (КонсультантПлюс).
model HuntingLaw {
  /// Ключ из списка в hunting-laws-shared.ts
  key        String   @id
  /// «29.12.2025» — дата последней редакции (у статей кодексов — последнего изменения)
  edition    String   @default("")
  /// Редакции из обзора изменений либо поправки к статье
  dataJson   String   @default("")
  hash       String   @default("")
  changedAt  DateTime @default(now())
  fetchedAt  DateTime @default(now())
}

/// Сбор на охоту из охотничьей группы (/sbor): кнопки «еду / думаю / не еду».
model HuntingGathering {
  id        String                 @id @default(cuid())
  chatId    String
  threadId  Int?
  messageId Int?
  /// Ключ вида из таблицы патронов (hunting-ammo.ts), если распознан
  species   String                 @default("")
  title     String
  /// ГГГГ-ММ-ДД
  date      String
  createdBy String                 @default("")
  createdAt DateTime               @default(now())
  votes     HuntingGatheringVote[]

  @@index([date])
}

model HuntingGatheringVote {
  gatheringId String
  userId      String
  name        String
  /// go | maybe | no
  answer      String
  updatedAt   DateTime         @updatedAt
  gathering   HuntingGathering @relation(fields: [gatheringId], references: [id], onDelete: Cascade)

  @@id([gatheringId, userId])
}

/// Срок личного документа охотника — напоминания только в личку бота.
model HuntingDocument {
  id        String   @id @default(cuid())
  /// Telegram id пользователя (он же id личного чата с ботом)
  userId    String
  /// Имя из Telegram на момент последней записи
  name      String   @default("")
  /// roha | medsprav | putevka | razreshenie
  kind      String
  /// Подпись пользователя: «МР-155», «утка»…
  label     String   @default("")
  /// ГГГГ-ММ-ДД, последний день действия
  expires   String
  /// false — пользователь заблокировал бота
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kind, label])
  @@index([expires])
}

/// Обращение к охотничьему боту — для аналитики «кто и о чём спрашивает».
model HuntingBotEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  name      String   @default("")
  username  String   @default("")
  chatId    String
  /// private | group | supergroup
  chatType  String
  chatTitle String   @default("")
  /// Раздел: Виды дичи, Закон, Погода…
  section   String
  /// Ключ темы: utka, pravila, sbor_vote…
  topic     String
  /// Тема по-русски: «Утка», «Правила охоты…»
  title     String
  /// Текст запроса без личных данных (для /dokument — только команда), до 200 символов
  text      String   @default("")

  @@index([createdAt])
  @@index([userId])
}

/// Реплики разговора с охотничьим ботом (GigaChat) — память диалога и дневные лимиты.
model HuntingChatMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  chatId    String
  /// Кто спросил (для ответов бота — кому ответил)
  userId    String
  name      String   @default("")
  /// user | assistant
  role      String
  content   String
  /// Токены GigaChat на ответ (у реплик user — 0)
  tokens    Int      @default(0)

  @@index([chatId, createdAt])
  @@index([userId, createdAt])
}

/// Внешние ограничения для охоты в Шатуре: карантины (pravo.gov.ru) и запрет посещения лесов (Мособллес).
model HuntingAlert {
  id          String   @id @default(cuid())
  url         String   @unique
  /// quarantine | forest
  kind        String
  /// asf | rabies | other — для карантинов
  disease     String   @default("")
  /// set — введено, cancel — отменено
  action      String
  title       String
  /// ГГГГ-ММ-ДД, дата публикации
  date        String
  firstSeenAt DateTime @default(now())

  @@index([kind, date])
}

/// Происшествия в лесу и на воде: найденные в местных каналах (на модерацию) и присланные охотниками (/vnimanie).
model HuntingIncident {
  id             String   @id @default(cuid())
  url            String   @unique
  /// tg:канал | vk:группа | regions | hunter
  source         String
  sourceLabel    String   @default("")
  text           String
  /// ISO-время публикации в источнике
  publishedAt    DateTime
  /// pending — ждёт модератора; published — в чатах; skipped — отклонено или дубль; seen — было до запуска
  status         String
  /// Слова текста для поиска дублей между источниками
  fingerprint    String   @default("")
  /// Фото из оригинала — для админки
  photoUrl       String?
  /// То же фото в Telegram после показа модератору — для рассылки в чаты
  photoFileId    String?
  /// Все фото поста (альбом): JSON [{ url, fileId }]; photoUrl / photoFileId — первое из них
  photosJson     String   @default("")
  adminMessageId Int?
  /// Сообщения альбома у модератора — удалить при повторной отправке
  adminAlbumIds  String   @default("")
  /// Рубрики через запятую: search, fire, road, wildlife, danger, water, mushroom, other
  rubrics        String   @default("")
  /// Где случилось: «д. Бордуки», «Северная Грива»
  place          String   @default("")
  /// Повтор этой новости из другого канала — id первой
  duplicateOf    String?
  createdAt      DateTime @default(now())

  @@index([status, publishedAt])
  @@index([duplicateOf])
}

/// Слова, которые модератор добавил в шум (add) или просил больше не предлагать (ignore)
model HuntingNoiseWord {
  /// Первые 6 букв слова, как в отпечатке новости
  stem      String   @id
  /// add | ignore
  action    String
  /// Пример слова целиком — для показа
  sample    String   @default("")
  createdAt DateTime @default(now())
}

/// Подписка охотника на рубрики новостей в личку бота
model HuntingSubscription {
  userId    String
  rubric    String
  name      String   @default("")
  /// false — пользователь заблокировал бота
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@id([userId, rubric])
  @@index([rubric])
}

model HuntingNotice {
  key    String   @id
  sentAt DateTime @default(now())
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  login     String   @unique
  password  String
  name      String
  role      String   @default("partner")
  createdAt DateTime @default(now())
  sales     Sale[]
  receipts  StockReceipt[]
}

model Product {
  id               String            @id @default(cuid())
  name             String
  description      String?
  imageUrl         String?
  costPrice        Float
  listPrice        Float?
  stock            Int               @default(0)
  active           Boolean           @default(true)
  weightGrams      Float?
  widthMm          Float?
  heightMm         Float?
  depthMm          Float?
  viewCount        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sales            Sale[]
  receipts         StockReceipt[]
  priceHistory     PriceHistory[]
  feedbackMessages FeedbackMessage[]
}

model PriceHistory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPrice    Float?
  newPrice    Float?
  changedAt   DateTime @default(now())
  changedById String?
}

model Sale {
  id           String      @id @default(cuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id])
  quantity     Int         @default(1)
  amount       Float
  costTotal    Float
  profit       Float
  ownerShare   Float
  partnerShare Float
  note         String?
  soldAt       DateTime    @default(now())
  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id])
  createdById  String?
  createdBy    User?       @relation(fields: [createdById], references: [id])
}

model Settlement {
  id           String   @id @default(cuid())
  periodFrom   DateTime
  periodTo     DateTime @default(now())
  totalRevenue Float
  totalCost    Float
  totalProfit  Float
  ownerShare   Float
  partnerShare Float
  note         String?
  createdAt    DateTime @default(now())
  sales        Sale[]
}

model AppSetting {
  id                String @id @default("default")
  ownerSplitPercent Float  @default(50)
  sessionEpoch      Int    @default(0)
}

model StockReceipt {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  note        String?
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
}

model SiteVisit {
  id        String   @id @default(cuid())
  ipAddress String
  path      String
  userAgent String?
  visitedAt DateTime @default(now())

  @@index([ipAddress])
  @@index([visitedAt])
}

model FeedbackMessage {
  id        String   @id @default(cuid())
  name      String?
  contact   String?
  message   String
  ipAddress String?
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([read])
  @@index([productId])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  type      String
  ipAddress String
  path      String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type])
  @@index([ipAddress])
}

model BlockedIp {
  id        String   @id @default(cuid())
  ipAddress String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@index([ipAddress])
}

model WorldTrendBatch {
  id          String              @id @default(cuid())
  weekLabel   String              @unique
  generatedAt DateTime            @default(now())
  source      String              @default("bot")
  articles    WorldTrendArticle[]

  @@index([generatedAt])
}

model WorldTrendArticle {
  id          String          @id @default(cuid())
  batchId     String
  batch       WorldTrendBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  name        String
  description String
  imageUrl    String?
  sourceUrl   String?
  priceTier   String
  priceLabel  String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())

  @@index([batchId])
  @@index([priceTier])
}

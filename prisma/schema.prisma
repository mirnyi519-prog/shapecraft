generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  login     String   @unique
  password  String
  name      String
  role      String   @default("partner")
  createdAt DateTime @default(now())
  sales     Sale[]
  receipts  StockReceipt[]
}

model Product {
  id           String         @id @default(cuid())
  name         String
  description  String?
  imageUrl     String?
  costPrice    Float
  listPrice    Float?
  stock        Int            @default(0)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sales        Sale[]
  receipts     StockReceipt[]
  priceHistory PriceHistory[]
}

model PriceHistory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPrice    Float?
  newPrice    Float?
  changedAt   DateTime @default(now())
  changedById String?
}

model Sale {
  id           String      @id @default(cuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id])
  quantity     Int         @default(1)
  amount       Float
  costTotal    Float
  profit       Float
  ownerShare   Float
  partnerShare Float
  note         String?
  soldAt       DateTime    @default(now())
  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id])
  createdById  String?
  createdBy    User?       @relation(fields: [createdById], references: [id])
}

model Settlement {
  id           String   @id @default(cuid())
  periodFrom   DateTime
  periodTo     DateTime @default(now())
  totalRevenue Float
  totalCost    Float
  totalProfit  Float
  ownerShare   Float
  partnerShare Float
  note         String?
  createdAt    DateTime @default(now())
  sales        Sale[]
}

model AppSetting {
  id                String @id @default("default")
  ownerSplitPercent Float  @default(50)
}

model StockReceipt {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  note        String?
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
}

model SiteVisit {
  id        String   @id @default(cuid())
  ipAddress String
  path      String
  userAgent String?
  visitedAt DateTime @default(now())

  @@index([ipAddress])
  @@index([visitedAt])
}

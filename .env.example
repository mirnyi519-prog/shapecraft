DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-random-string"
OWNER_LOGIN="admin"
OWNER_PASSWORD="shapecraft123"
PARTNER_LOGIN="partner"
PARTNER_PASSWORD="shapecraft123"
# Для HTTPS поставьте COOKIE_SECURE=true
COOKIE_SECURE="false"
# Московское время (сервер и контейнер)
TZ="Europe/Moscow"
# Секрет для автовыгрузки подборки «В мире» с агента Cursor (Bearer token)
WORLD_IMPORT_SECRET="change-me-to-random-string"
# Куда выгружать с локальной машины (npm run world:publish)
WORLD_PUBLISH_URL="https://shapecraft.ru/api/world/import"
# Откуда сервер берёт JSON подборки при синхронизации
WORLD_SYNC_URL="https://raw.githubusercontent.com/mirnyi519-prog/shapecraft/master/data/world-import.json"
# Telegram служебный: клики «Купить», приход, продажа (нужны оба)
# TELEGRAM_BOT_TOKEN="123456:ABC..."
# TELEGRAM_CHAT_ID="-1001234567890"
# Telegram маркет: ShapeCraft Market → kupipro77 (чат -100… + топик)
# TELEGRAM_MARKET_BOT_TOKEN="123456:DEF..."
# TELEGRAM_MARKET_CHAT_ID="-1002313269004"
# TELEGRAM_MARKET_THREAD_ID="26"
# Telegram охота: отдельный бот → публичная группа (можно @username группы)
# TELEGRAM_HUNTING_BOT_TOKEN="123456:GHI..."
# TELEGRAM_HUNTING_CHAT_ID="@shatura_hunting"
# Ещё группы для тех же рассылок, через запятую (по умолчанию в docker-compose.yml)
# TELEGRAM_HUNTING_EXTRA_CHAT_IDS="-1004465864823"
# Кому бот присылает найденные происшествия на одобрение (свой id — /myid в личке бота)
# TELEGRAM_HUNTING_ADMIN_ID="123456789"# Публичный URL сайта для фото в Telegram (по умолчанию https://shapecraft.ru)
# PUBLIC_SITE_URL="https://shapecraft.ru"
